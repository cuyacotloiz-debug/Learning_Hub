// Prisma schema for Learning Hub
// Datasource: PostgreSQL (set DATABASE_URL in environment)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String      @id @default(cuid())
  firstName    String
  lastName     String
  email        String      @unique
  passwordHash String
  role         Role
  profileImage String?
  classrooms   Classroom[] @relation("TeacherClassrooms")
  enrollments  Enrollment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Classroom {
  id          String          @id @default(cuid())
  classroomId String          @unique
  name        String
  subject     String
  description String?
  status      ClassroomStatus @default(ACTIVE)
  teacherId   String
  teacher     User            @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  joinedAt    DateTime  @default(now())

  @@unique([studentId, classroomId])
}
